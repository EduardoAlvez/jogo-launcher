<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.portfolio</groupId>
    <artifactId>jogo-launcher</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Jogo Launcher - Portfolio Java</name>
    <description>Launcher do portfolio de jogos em Java (estilo cliente do League of Legends antigo): banner em destaque ocupando a janela, cards dos quatro jogos por cima e botao JOGAR. Abre cada jogo (Pong, Forca, Snake e Campo Minado) em processo externo com o java da propria JVM; Java 17 e Swing, sem dependencias de execucao; testes com JUnit + Surefire + JaCoCo</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.portfolio.launcher.ui.TelaLauncher</main.class>
        <logo.ico>${project.basedir}/src/main/resources/logo.ico</logo.ico>
        <exe.version>1.0.0.0</exe.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <id>launcher</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/jogo-launcher.exe</outfile>
                            <jar>${project.build.directory}/jogo-launcher-${project.version}.jar</jar>
                            <icon>${logo.ico}</icon>
                            <chdir>.</chdir>
                            <versionInfo>
                                <fileVersion>${exe.version}</fileVersion>
                                <txtFileVersion>${exe.version}</txtFileVersion>
                                <fileDescription>Launcher do portfolio de jogos</fileDescription>
                                <copyright>Eduardo Alvez</copyright>
                                <productVersion>${exe.version}</productVersion>
                                <txtProductVersion>${exe.version}</txtProductVersion>
                                <productName>Jogo Launcher</productName>
                                <internalName>jogo-launcher</internalName>
                                <originalFilename>jogo-launcher.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>